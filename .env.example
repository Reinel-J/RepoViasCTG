# Copia este archivo a ".env" (en la misma carpeta raíz, junto a docker-compose.yml)
# y genera un valor real con: openssl rand -base64 32
JWT_SECRET=pega-aqui-tu-secreto-generado

# Opcional: crea (o promueve) este usuario como ADMIN al arrancar el backend.
# La contraseña solo se usa si la cuenta no existe todavía (mínimo 8 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=
