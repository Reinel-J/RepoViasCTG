# Copia este archivo a ".env" (en la misma carpeta raíz, junto a docker-compose.yml)
# y genera un valor real con: openssl rand -base64 32
JWT_SECRET=pega-aqui-tu-secreto-generado

# Opcional: crea (o promueve) este usuario como ADMIN al arrancar el backend.
# La contraseña solo se usa si la cuenta no existe todavía (mínimo 8 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# URL pública del frontend: se usa en el enlace de recuperación de contraseña.
FRONTEND_URL=http://localhost:5173

# SMTP para enviar el correo de recuperación. Si SPRING_MAIL_HOST queda vacío, el enlace
# solo se escribe en el log del backend (útil en desarrollo).
# Ejemplo Gmail: host smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

# Opcional: identificación ante Nominatim (OpenStreetMap). Su política de uso pide un User-Agent propio,
# idealmente con un correo de contacto real, por ejemplo: ViaCTG/1.0 (tucorreo@dominio.com)
NOMINATIM_USER_AGENT=

# Opcional: área de servicio. Con true (por defecto) solo se aceptan reportes dentro de Cartagena.
ZONA_HABILITADA=true

# Opcional: IP de los proxies delante del backend, como expresión regular de Tomcat. Solo de ellas se aceptan
# X-Forwarded-For (IP real del visitante) y X-Forwarded-Proto. Con docker compose, por defecto, la red interna de
# Docker (172.16.0.0/12), donde están el nginx del frontend y el túnel. Fuera de Docker (mvnw spring-boot:run) el
# valor por defecto es vacío: no se confía en ningún proxy.
# TRUSTED_PROXIES=

# Opcional: cierre por la comunidad. Con true, un reporte EN PROCESO se cierra solo cuando al menos 3 votos dicen
# «ya está arreglado» y son al menos el 75 % (el del autor cuenta doble), si en 72 horas nadie lo evita.
CIERRE_COMUNITARIO=false

# Opcional: en producción puedes ocultar Swagger UI con false.
SWAGGER_ENABLED=true

# Opcional: URL de la API que usará el frontend (se fija al construir la imagen). Por defecto /api: el nginx del
# frontend la reenvía al backend, así que todo el sitio queda en una sola dirección (http://localhost:5173).
VITE_API_URL=/api

# Opcional: cada cuánto (ms) la campana consulta las notificaciones sin leer; también se fija al construir.
VITE_NOTIFICACIONES_INTERVALO_MS=60000
