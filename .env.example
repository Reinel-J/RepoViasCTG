# Copia este archivo a ".env" (en la misma carpeta raíz, junto a docker-compose.yml)
# y genera un valor real con: openssl rand -base64 32
JWT_SECRET=pega-aqui-tu-secreto-generado

# Contraseña del usuario "viasctg" de la base secundaria (PostgreSQL, réplica de MongoDB). Genera una con:
# openssl rand -base64 18
SQL_PASSWORD=pega-aqui-otra-contrasena-generada
# Opcional: false apaga la réplica (la API funciona igual, solo con MongoDB).
SQL_REPLICA_HABILITADA=true

# Opcional: crea (o promueve) este usuario como ADMIN al arrancar el backend.
# La contraseña solo se usa si la cuenta no existe todavía (mínimo 8 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# URL pública del frontend: se usa en los enlaces de los correos y en la dirección pública de Metabase
# (FRONTEND_URL + /metabase). En un servidor: https://tu-dominio (ver docs/azure.md).
FRONTEND_URL=http://localhost:5173
# Solo en un servidor, con docker compose --profile https: dominio para el certificado HTTPS (docs/azure.md).
# Ejemplo en Azure: viactg-demo.eastus.cloudapp.azure.com
DOMINIO=

# Opcional: «Continuar con Google» en el login y el registro (guía: docs/google.md). Client ID de tipo «Aplicación web»
# de Google Cloud Console; vacío, el botón no aparece. No hace falta el client secret.
GOOGLE_CLIENT_ID=

# SMTP para enviar el correo de recuperación. Si SPRING_MAIL_HOST queda vacío, el enlace
# solo se escribe en el log del backend (útil en desarrollo).
# Ejemplo Gmail: host smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

# Opcional: identificación ante Nominatim (OpenStreetMap). Su política de uso pide un User-Agent propio,
# idealmente con un correo de contacto real, por ejemplo: ViaCTG/1.0 (tucorreo@dominio.com)
NOMINATIM_USER_AGENT=

# Opcional: área de servicio. Con true (por defecto) solo se aceptan reportes dentro de Cartagena.
ZONA_HABILITADA=true

# Opcional: IP de los proxies delante del backend, como expresión regular de Tomcat. Solo de ellas se aceptan
# X-Forwarded-For (IP real del visitante) y X-Forwarded-Proto. Con docker compose, por defecto, la red interna de
# Docker (172.16.0.0/12), donde están el nginx del frontend y el túnel. Fuera de Docker (mvnw spring-boot:run) el
# valor por defecto es vacío: no se confía en ningún proxy.
# TRUSTED_PROXIES=

# Opcional: cierre por la comunidad. Con true, un reporte EN PROCESO se cierra solo cuando al menos 3 votos dicen
# «ya está arreglado» y son al menos el 75 % (el del autor cuenta doble), si en 72 horas nadie lo evita.
CIERRE_COMUNITARIO=false

# Opcional: dashboard de Metabase en el panel de administración (guía: docs/metabase.md).
# METABASE_SECRET_KEY: clave de embebido que se copia de Admin > Embedding de Metabase; nunca sale del backend.
# METABASE_DASHBOARD_ID: número del dashboard publicado para embeber (el de la URL /dashboard/<id>).
# METABASE_TOKEN_MINUTOS: vigencia de cada URL firmada; el panel pide otra antes de que venza.
# Con docker compose, METABASE_SECRET_KEY y METABASE_DASHBOARD_ID se dejan vacíos: el servicio metabase-setup arma el
# dashboard solo y se los pasa al backend. Llénalos solo si lo configuras a mano.
# METABASE_ADMIN_EMAIL / METABASE_ADMIN_PASSWORD: cuenta de administrador de Metabase que crea metabase-setup. Vacíos,
# usa ADMIN_EMAIL y una contraseña aleatoria (docs/metabase.md explica cómo verla).
# METABASE_SITE_URL: con docker compose, /metabase (el nginx del frontend reenvía esa ruta a Metabase, en la misma
# dirección del sitio). Sin Docker, la dirección de Metabase, por ejemplo http://localhost:3000.
METABASE_SITE_URL=/metabase
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
METABASE_SECRET_KEY=
METABASE_DASHBOARD_ID=
METABASE_TOKEN_MINUTOS=10

# Datos de demostración: al arrancar, si hay menos de 20 reportes, el backend crea SEED_DEMO_REPORTES reportes con
# ciudadanos, moderadores, comentarios, confirmaciones y votos proporcionales. Con 10000 la base queda con más de
# 23 000 documentos. Vienen activados para la evaluación; en un despliegue real pon SEED_DEMO=false. Se reconocen por
# "[DEMO]" y @demo.viasctg.local.
SEED_DEMO=true
SEED_DEMO_REPORTES=10000

# Opcional: en producción puedes ocultar Swagger UI con false.
SWAGGER_ENABLED=true

# Opcional: URL de la API que usará el frontend (se fija al construir la imagen). Por defecto /api: el nginx del
# frontend la reenvía al backend, así que todo el sitio queda en una sola dirección (http://localhost:5173).
VITE_API_URL=/api

# Opcional: cada cuánto (ms) la campana consulta las notificaciones sin leer; también se fija al construir.
VITE_NOTIFICACIONES_INTERVALO_MS=60000
