# Copia este archivo a ".env" (en la misma carpeta raíz, junto a docker-compose.yml)
# y genera un valor real con: openssl rand -base64 32
JWT_SECRET=pega-aqui-tu-secreto-generado

# Opcional: crea (o promueve) este usuario como ADMIN al arrancar el backend.
# La contraseña solo se usa si la cuenta no existe todavía (mínimo 8 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública del frontend: se usa en el enlace de recuperación de contraseña.
FRONTEND_URL=http://localhost:5173

# SMTP para enviar el correo de recuperación. Si SPRING_MAIL_HOST queda vacío, el enlace
# solo se escribe en el log del backend (útil en desarrollo).
# Ejemplo Gmail: host smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
