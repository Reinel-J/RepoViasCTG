{
  "info": {
    "name": "ViaCTG",
    "description": "Backend ViaCTG. Haz Login (o Registro) primero: el token se guarda en {{token}} y la colección lo envía como Bearer en todas las peticiones. Las carpetas marcadas (ADMIN/MODERADOR) exigen ese rol: un usuario nuevo es CIUDADANO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "reporteId",
      "value": ""
    },
    {
      "key": "barrioId",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "comentarioId",
      "value": ""
    },
    {
      "key": "notificacionId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea un usuario CIUDADANO y devuelve el JWT (se guarda en {{token}}). 409 si el correo ya existe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"email\": \"postman@test.com\",\n  \"password\": \"Password123\",\n  \"telefono\": \"300 123 4567\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set('token', d.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el JWT (se guarda en {{token}}). 401 si las credenciales son inválidas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@test.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set('token', d.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reportes",
